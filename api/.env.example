# Copy this file to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
# The Next.js frontend's default dev port is 3000, so the API uses a
# different port locally to avoid colliding with it.
PORT=4000

# PostgreSQL connection string (Neon, Supabase, or any Postgres host).
DATABASE_URL="postgresql://user:password@localhost:5432/sms?schema=public"

# The deployed Next.js frontend's origin, for CORS.
FRONTEND_ORIGIN="http://localhost:3000"

# Generate each with: openssl rand -base64 32 — use two DIFFERENT secrets,
# never reuse one between access and refresh.
JWT_ACCESS_SECRET="generate-your-own-with-openssl-rand--base64-32"
JWT_REFRESH_SECRET="generate-a-different-one-with-openssl-rand--base64-32"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# S3-compatible object storage — works against AWS S3, Supabase Storage,
# Cloudflare R2, or a local MinIO instance for dev (`brew install minio`).
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="sms-uploads"
STORAGE_ACCESS_KEY_ID="your-access-key"
STORAGE_SECRET_ACCESS_KEY="your-secret-key"
STORAGE_PUBLIC_URL_BASE="http://localhost:9000/sms-uploads"
# true for MinIO/most non-AWS providers; set to false for real AWS S3.
STORAGE_FORCE_PATH_STYLE="true"

# BullMQ queue backend — local Redis for dev (`brew install redis`),
# Upstash (or any managed Redis) in production.
REDIS_HOST="localhost"
REDIS_PORT=6379

# Paystack — get test-mode keys from the Paystack dashboard's "Test" view.
# Secret key only; the public key is never used server-side (the frontend
# opens the hosted checkout authorization_url, not Paystack Inline JS).
PAYSTACK_SECRET_KEY="sk_test_your-test-secret-key"
PAYSTACK_BASE_URL="https://api.paystack.co"

# Termii — get an API key from termii.com (sender ID needs separate
# registration/approval per Termii's process for Nigerian routes).
TERMII_API_KEY="your-termii-api-key"
TERMII_SENDER_ID="DemoSchool"
TERMII_BASE_URL="https://v3.api.termii.com"

# Resend — get an API key from resend.com; EMAIL_FROM must be on a
# domain you've verified with Resend.
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="noreply@yourschool.ng"

# WhatsApp Business API via Termii's WhatsApp product — needs a separate
# BSP-approved WhatsApp sender number from Termii (or swap in 360dialog and
# adjust WhatsAppProviderService's request shape).
WHATSAPP_API_KEY="your-termii-api-key"
WHATSAPP_SENDER_ID="2348000000000"
WHATSAPP_BASE_URL="https://v3.api.termii.com"

# Web Push — self-generated, no external account needed:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@yourschool.ng"

# AI-assisted report-card comment suggestions (Stage 30) — get a key at
# https://console.anthropic.com
ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_MODEL="claude-sonnet-5"
